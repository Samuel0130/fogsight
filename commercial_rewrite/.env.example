## Server
HOST=127.0.0.1
PORT=8010

## Access password (required for public deploy)
ACCESS_PASSWORD=change-me
# SESSION_SECRET=optional-random-string

## Provider (choose one): gemini | poe | openai

## Gemini
# PROVIDER=gemini
# MODEL=gemini-2.5-pro
# API_KEY=YOUR_GEMINI_API_KEY

## Poe (OpenAI-compatible)
PROVIDER=poe
BASE_URL=https://api.poe.com/v1
MODEL=Claude-Sonnet-4
POE_API_KEY=YOUR_POE_API_KEY

## OpenAI-compatible (OpenAI/OpenRouter/others)
# PROVIDER=openai
# BASE_URL=https://openrouter.ai/api/v1
# MODEL=anthropic/claude-3.5-sonnet
# API_KEY=YOUR_OPENAI_OR_OPENROUTER_KEY
